{
  "name": "rare-daily",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test test/*.test.js",
    "check": "tsc --noEmit",
    "deploy": "npm run bank:build && npm run check && npm test && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "bank:build": "node scripts/build-bank.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  },
  "license": "MIT",
  "description": "A daily rare-answer trivia game that flies through an illustrated sky, built on Cloudflare Workers and D1."
}
