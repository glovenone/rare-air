{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rare-daily",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "routes": [{ "pattern": "krillionunlimited.top", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "rare-daily-db", "database_id": "bca74756-9c72-4e77-8a9b-68cc831dfa40", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
